  "patterns": [
    {
      "re": "^(\\d+)\\s+threat(?:s)? detected$",
      "zh": "检测到 $1 个威胁"
    },
    {
      "re": "^(\\d+)\\s+detected$",
      "zh": "检测到 $1 个"
    },
    {
      "re": "^You have (\\d+) of (\\d+) local custom rules\\. Upgrade to Cloud for unlimited rules with ML-powered detection\\.$",
      "zh": "您已使用 $1 / $2 条本地自定义规则。升级到云端即可获得无限规则和 ML 驱动的检测。"
    },
    {
      "re": "^Key: not configured$",
      "zh": "密钥：未配置"
    },
    {
      "re": "^Key: (.+) · from (.+)$",
      "zh": "密钥：$1 · 来源：$2"
    },
    {
      "re": "^Key: (?!not configured$)(?!.* · from )(.+)$",
      "zh": "密钥：$1"
    },
    {
      "re": "^Drift extraction: enabled$",
      "zh": "漂移提取：已启用"
    },
    {
      "re": "^Drift extraction: disabled$",
      "zh": "漂移提取：未启用"
    },
    {
      "re": "^Drift extraction: (?!enabled$|disabled$)(.+)$",
      "zh": "漂移提取：$1"
    },
    {
      "re": "^Agent model: (.+)$",
      "zh": "Agent 模型：$1"
    }
  ]
