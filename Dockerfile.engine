# AI Aegis Engine — headless web-server image built from this repository.
# Multi-platform: linux/amd64, linux/arm64.
# Not published to any registry — build it locally (see docker-compose.self-host.yml).
#
# Runtime contract:
#   - serves on $PORT (default 8741) bound to 0.0.0.0
#   - data dir: $HOME/.local/share/aegis/threat-monitor (HOME=/home/aegis
#     -> the modules' default persistence_mount_path)
#   - if AEGIS_ENROLL_TOKEN (aet_*) is set, enrolls before serving
FROM python:3.11-slim

ARG AEGIS_APT_MIRROR=""
ARG AEGIS_APT_SECURITY_MIRROR=""
ARG AEGIS_PIP_INDEX_URL=""

ENV PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    HOME=/home/aegis \
    PORT=8741 \
    AEGIS_CONTAINER=1

RUN if [ -n "$AEGIS_APT_MIRROR" ]; then \
        sed -i "s|http://deb.debian.org/debian|$AEGIS_APT_MIRROR|g" /etc/apt/sources.list.d/debian.sources; \
    fi \
    && if [ -n "$AEGIS_APT_SECURITY_MIRROR" ]; then \
        sed -i "s|http://deb.debian.org/debian-security|$AEGIS_APT_SECURITY_MIRROR|g" /etc/apt/sources.list.d/debian.sources; \
    fi \
    && apt-get update \
    && apt-get install -y --no-install-recommends curl build-essential \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /opt/ai-aegis
COPY setup.py pyproject.toml MANIFEST.in README.md LICENSE NOTICE ./
COPY benchmarks/ ./benchmarks/
COPY src/ ./src/
RUN if [ -n "$AEGIS_PIP_INDEX_URL" ]; then \
        pip install --no-cache-dir --index-url "$AEGIS_PIP_INDEX_URL" ".[app]"; \
    else \
        pip install --no-cache-dir ".[app]"; \
    fi \
    && apt-get purge -y build-essential \
    && apt-get autoremove -y \
    && rm -rf /root/.cache

COPY docker-entrypoint.sh /usr/local/bin/docker-entrypoint.sh
RUN chmod +x /usr/local/bin/docker-entrypoint.sh \
    && useradd -m -u 1000 -d /home/aegis aegis \
    && mkdir -p /home/aegis/.local/share/aegis/threat-monitor \
    && chown -R aegis:aegis /home/aegis
USER aegis
WORKDIR /home/aegis

EXPOSE 8741
HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=5 \
    CMD curl -fsS "http://127.0.0.1:${PORT:-8741}/health" || exit 1

ENTRYPOINT ["/usr/local/bin/docker-entrypoint.sh"]

LABEL org.opencontainers.image.title="Aegis Engine" \
      org.opencontainers.image.description="AI Aegis threat-monitor engine for self-hosted deployments." \
      org.opencontainers.image.source="https://gitee.com/wan-xianghao/ai-aegis" \
      org.opencontainers.image.licenses="Apache-2.0"
