# Aegis ENGINE — headless web-server image for self-host (BYOC / Terraform).
# Built from the PUBLISHED PyPI package, pinned to a version (build-arg VERSION).
# Multi-platform: linux/amd64, linux/arm64.
# Published to: ghcr.io/Wanshanghao/ai-aegis
#
# Contract expected by the terraform-<cloud>-aegis modules:
#   - serves on $PORT (default 8741) bound to 0.0.0.0
#   - data dir: $HOME/.local/share/aegis/threat-monitor (HOME=/home/aegis
#     -> the modules' default persistence_mount_path)
#   - if AEGIS_ENROLL_TOKEN (svet_*) is set, enrolls before serving
FROM python:3.11-slim

# VERSION must be a released ai-aegis version on PyPI (e.g. 4.7.1).
# EXTRA is the install extra: "app" works for all releases; 4.8.0+ may offer a
# leaner "server" extra (no pywebview/watchdog).
ARG VERSION
ARG EXTRA=app

ENV PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    HOME=/home/aegis \
    PORT=8741 \
    AEGIS_CONTAINER=1

RUN apt-get update \
    && apt-get install -y --no-install-recommends curl \
    && rm -rf /var/lib/apt/lists/*

# Pinned install of the released engine. `--web` runs headless (no native window;
# webview/watchdog are present with [app] but a window is never created).
RUN test -n "${VERSION}" || (echo "ERROR: --build-arg VERSION=<x.y.z> is required" && exit 1) \
    && pip install --no-cache-dir "ai-aegis[${EXTRA}]==${VERSION}"

COPY docker-entrypoint.sh /usr/local/bin/docker-entrypoint.sh
RUN chmod +x /usr/local/bin/docker-entrypoint.sh \
    && useradd -m -u 1000 -d /home/aegis aegis \
    && mkdir -p /home/aegis/.local/share/aegis/threat-monitor \
    && chown -R aegis:aegis /home/aegis
USER aegis
WORKDIR /home/aegis

EXPOSE 8741
HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=5 \
    CMD curl -fsS "http://127.0.0.1:${PORT:-8741}/health" || exit 1

ENTRYPOINT ["/usr/local/bin/docker-entrypoint.sh"]

LABEL org.opencontainers.image.title="Aegis Engine" \
      org.opencontainers.image.description="Aegis threat-monitor engine — headless server image for self-host (BYOC / Terraform)." \
      org.opencontainers.image.source="https://github.com/Wanshanghao/ai-aegis" \
      org.opencontainers.image.licenses="Apache-2.0"
