# Aegis MCP Server Environment Variables
# Copy this file to .env and configure your settings

# API Key (optional - enables cloud/hybrid mode)
# If not set, server runs in local-only mode
# AEGIS_API_KEY=your_api_key_here

# Server Configuration
AEGIS_MCP_MODE=balanced          # Options: development, balanced, production
AEGIS_MCP_LOG_LEVEL=INFO         # Options: DEBUG, INFO, WARNING, ERROR
AEGIS_MCP_TRANSPORT=stdio        # Options: stdio, http, sse

# Server Network Settings (for HTTP/SSE transports)
AEGIS_MCP_HOST=localhost
AEGIS_MCP_PORT=8000

# Optional: Custom configuration file path
# AEGIS_CONFIG_PATH=/app/config

# Optional: Custom data directory
# AEGIS_DATA_PATH=/app/data
