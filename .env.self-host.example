# Copy to .env.self-host and replace every CHANGE_ME value before deployment.
AEGIS_ENGINE_DOMAIN=engine.your-domain.com
AEGIS_CONTROL_DOMAIN=control.your-domain.com
AEGIS_ENGINE_LOCAL_PORT=8741
AEGIS_CONTROL_LOCAL_PORT=8780
# Optional build mirrors for regions where Docker's default Debian/PyPI endpoints are slow.
AEGIS_APT_MIRROR=
AEGIS_APT_SECURITY_MIRROR=
AEGIS_PIP_INDEX_URL=
AEGIS_CONTROL_PLANE_ADMIN_KEY=CHANGE_ME_USE_AT_LEAST_32_RANDOM_CHARACTERS
AEGIS_ENGINE_INGRESS_TOKEN=CHANGE_ME_USE_A_DIFFERENT_32_RANDOM_CHARACTER_SECRET
AEGIS_ORG_ID=org_your_company
AEGIS_ORG_NAME=Your Company
AEGIS_ADMIN_EMAIL=security@your-domain.com
