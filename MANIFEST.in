include README.md
include LICENSE
include NOTICE
include CONTRIBUTOR_AGREEMENT.md
recursive-include rules *.yaml
recursive-include rules *.yml
include rules/README.md
include rules/RULES_ATTRIBUTION.md
include rules/LICENSE_NOTICE.md
recursive-include src/aegis/plugins/claude-code *
recursive-include src/aegis/plugins/claude-code/.claude-plugin *
recursive-include src/aegis/plugins/codex *
recursive-include src/aegis/plugins/codex/.codex-plugin *
recursive-include src/aegis/plugins/copilot-cli *
recursive-include src/aegis/plugins/cursor *
recursive-include src/aegis/plugins/cursor/.cursor-plugin *
recursive-include src/aegis/guardian *.json.gz
recursive-include src/aegis/guardian *.sha256
include benchmarks/chinese_agent_security_p1.jsonl
global-exclude __pycache__
global-exclude *.py[co]
global-exclude *.pyo
global-exclude .git*
global-exclude .DS_Store
prune tests
prune demo
prune docs
prune .github
